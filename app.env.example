# ─────────────────────────────────────────────────────────────────────────────
# Analytics Workbench — Environment Configuration Template
# Copy this file to app.env and fill in your values.
#   cp app.env.example app.env
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="Analytics Workbench"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=analytics_workbench
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=aw_

# Streamlit Server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Super Admin (reference only — auth is database-backed)
ADMIN_EMAIL=admin@example.com
