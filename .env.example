# ─────────────────────────────────────────────────────────────────────────────
# Analytics Workbench — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Analytics Workbench"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required: used to encrypt stored API keys (Fernet/AES-128).
APP_SECRET_KEY=change-me-to-a-64-char-random-hex-string

# ── Database (SQLite) ─────────────────────────────────────────────────────────
# Leave DB_PATH blank to use the default: data/analytics_workbench.db
# Set to an absolute path to store the database elsewhere.
DB_PATH=
DB_PREFIX=aw_

# ── Streamlit Server ──────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── Initial Superadmin ────────────────────────────────────────────────────────
# Applied only on the very first launch when no superadmin exists in the DB.
# Change these before first launch. Ignored on subsequent starts.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password
